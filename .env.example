# App environment identity — NOT the same as NODE_ENV (Next.js always builds
# with NODE_ENV=production, including on Vercel Preview/Beta deployments).
# One of: development | staging | production. Leave unset locally (defaults
# to "development"); set to "staging" in the Beta Vercel project and
# "production" in the future production Vercel project. See src/lib/env.ts.
APP_ENV=

# Supabase
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
# Used server-side only for PDF/BOQ extraction, embeddings, and market
# research (web-search-backed). Never exposed to the client.
OPENAI_API_KEY=

# Payments
# Which PaymentProvider the Payment Service uses. Only "payfast" exists today;
# adding another provider means implementing PaymentProvider and adding it to
# the switch in src/lib/payments/provider-factory.ts.
PAYMENT_PROVIDER=payfast

# PayFast
# "sandbox" uses PayFast's public test merchant (10000100) if the two IDs
# below are left blank. Use "production" with your real merchant credentials
# to go live. Passphrase is optional but strongly recommended — set it to
# match whatever you configure in the PayFast merchant dashboard.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Development payment bypass
# Lets an admin/test account simulate a successful payment for a current
# pricing BOQ without needing real PayFast credentials, so the rest of the
# pipeline (processing/extraction/benchmarking) can be tested end-to-end.
# Only takes effect when APP_ENV/VERCEL_ENV resolve to something other than
# "production" AND this is "true" AND the caller is an authenticated admin
# — see src/lib/payments/dev-bypass.ts and src/lib/env.ts. Safe to enable in
# the Beta project; leave unset/false in the future production deployment.
DEV_PAYMENT_BYPASS=false

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Market research (Phase 6)
# Reuses OPENAI_API_KEY (see PDF extraction / embeddings above) — no separate
# key needed. Optional override for the Responses API model used for the
# web-search-backed market research call; defaults to gpt-4o-mini if unset.
# See src/config/market-research.ts.
MARKET_RESEARCH_MODEL=
